# Tide environment template
# Copy ke `.env.local` dan isi real values. Never commit `.env.local`.

# === Solana RPC (Helius free tier) ===
# Sign up at https://helius.dev for free API key
NEXT_PUBLIC_HELIUS_DEVNET_RPC=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_HELIUS_MAINNET_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# === Anchor program ID (placeholder — regenerate via `anchor keys list`) ===
NEXT_PUBLIC_TIDE_PROGRAM_ID=Tide1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Privy (non-crypto subscriber onboarding) ===
# https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-side only — used to verify Privy access tokens in API routes.
# Do NOT prefix with NEXT_PUBLIC_ (would leak to browser bundle).
PRIVY_APP_SECRET=

# === Arcium (encrypted intent compute) ===
# Apply for Cohort 2 Private Testnet: https://arcium.com/build
ARCIUM_CLUSTER_URL=https://devnet-cluster.arcium.com
ARCIUM_API_KEY=

# === MoonPay (fiat → USDC top-up) ===
# https://www.moonpay.com/business
NEXT_PUBLIC_MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=

# === Reflect (yield-bearing on idle USDC) ===
NEXT_PUBLIC_REFLECT_PROGRAM_ID=

# === Jupiter (swap execution backend) ===
# Public API, no key needed
NEXT_PUBLIC_JUPITER_API=https://quote-api.jup.ag/v6

# === Pyth (window pricing snapshot) ===
PYTH_PRICE_FEED_SOL_USD=H6ARHf6YXhGYeQfUzQNGk6rDNnLBQKrenN712K4AQJEG
